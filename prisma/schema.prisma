generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Artist {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  isVisible            Boolean            @default(true)
  bio                  String             @default("")
  aboutMe              String             @default("")
  portrait             String             @default("")
  order                Int                @default(0)
  soundcloudProfile    String?
  spotifyProfile       String?
  appleMusicProfile    String?
  youtubeProfile       String?
  instagramProfile     String?
  twitterProfile       String?
  facebookProfile      String?
  tiktokProfile        String?
  snapchatProfile      String?
  youtubeSocialProfile String?
  images               ArtistImage[]
  albums               Album[]
  boardPosts           BoardPost[]
  videos               ArtistVideo[]
  adminAccess          ArtistAdminAccess?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model ArtistVideo {
  id             String             @id @default(cuid())
  artistId       String             @unique
  artist         Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title          String?
  description    String?
  posterUrl      String?
  posterPathname String?
  sourceType     ArtistVideoSource?
  youtubeUrl     String?
  videoUrl       String?
  videosPageUrl  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model CrosshairVideo {
  id                String             @id @default(cuid())
  title             String
  description       String             @default("")
  artistName        String?
  type              CrosshairVideoType @default(UNCUT)
  youtubeVideoId    String?            @unique
  youtubeUrl        String
  thumbnailUrl      String?
  thumbnailPathname String?
  source            String             @default("MANUAL")
  durationSeconds   Int?
  privacyStatus     String?
  sortOrder         Int                @default(0)
  isVisible         Boolean            @default(true)
  publishedAt       DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([isVisible, type, sortOrder])
  @@index([publishedAt])
}

model ArtistAdminAccess {
  id           String   @id @default(cuid())
  artistId     String   @unique
  artist       Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Album {
  id                String       @id @default(cuid())
  title             String
  slug              String       @unique
  isVisible         Boolean      @default(true)
  autoShowOnRelease Boolean      @default(false)
  type              AlbumType
  coverArt          String       @default("")
  otherArtistName   String?
  aboutText         String       @default("")
  soundcloudUrl     String?
  spotifyUrl        String?
  appleMusicUrl     String?
  youtubeUrl        String?
  releaseDate       DateTime
  artistId          String
  artist            Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  images            AlbumImage[]
  songPlacements    SongAlbum[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([artistId])
}

model ArtistImage {
  id        String   @id @default(cuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  url       String
  pathname  String?
  usage     String   @default("portrait")
  altText   String   @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId, sortOrder])
}

model AlbumImage {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  pathname  String?
  usage     String   @default("cover")
  altText   String   @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId, sortOrder])
}

enum AlbumType {
  ALBUM
  SINGLE
  EP
}

enum ArtistVideoSource {
  YOUTUBE
  UPLOAD
}

enum CrosshairVideoType {
  UNCUT
  EDITED
  SHORT
}

model Song {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  isVisible         Boolean             @default(true)
  autoShowOnRelease Boolean             @default(false)
  duration          String              @default("")
  artwork           String              @default("")
  soundcloudUrl     String?
  spotifyUrl        String?
  appleMusicUrl     String?
  youtubeUrl        String?
  placements        SongAlbum[]
  images            SongImage[]
  meta              SongMeta?
  lyricBlocks       LyricBlock[]
  lyric             SongLyric?
  recordSlots       RecordPlayerTrack[]
}

model SongAlbum {
  id             String @id @default(cuid())
  songId         String
  albumId        String
  trackNumber    Int
  discNumber     Int    @default(1)
  placementOrder Int
  song           Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  album          Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([songId, albumId])
  @@index([songId, placementOrder])
  @@index([albumId, discNumber, trackNumber])
}

model SongImage {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  url       String
  pathname  String?
  usage     String   @default("artwork")
  altText   String   @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([songId, sortOrder])
}

model SongMeta {
  id          String    @id @default(cuid())
  songId      String    @unique
  song        Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  aboutText   String    @default("")
  tags        String[]  @default([])
  bpm         String    @default("")
  key         String    @default("")
  releaseDate DateTime?
  roles       Json      @default(dbgenerated("'[]'::jsonb"))
}

model LyricBlock {
  id          String       @id @default(cuid())
  songId      String
  song        Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  text        String
  blockOrder  Int
  annotations Annotation[]

  @@index([songId])
}

model Annotation {
  id           String     @id @default(cuid())
  lyricBlockId String
  lyricBlock   LyricBlock @relation(fields: [lyricBlockId], references: [id], onDelete: Cascade)
  startChar    Int
  endChar      Int
  explanation  String

  @@index([lyricBlockId])
}

model SongLyric {
  id          String           @id @default(cuid())
  songId      String           @unique
  song        Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  text        String           @default("")
  annotations SongAnnotation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SongAnnotation {
  id          String                @id @default(cuid())
  songLyricId String
  songLyric   SongLyric             @relation(fields: [songLyricId], references: [id], onDelete: Cascade)
  explanation String
  ranges      SongAnnotationRange[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([songLyricId])
}

model SongAnnotationRange {
  id               String         @id @default(cuid())
  songAnnotationId String
  songAnnotation   SongAnnotation @relation(fields: [songAnnotationId], references: [id], onDelete: Cascade)
  startChar        Int
  endChar          Int

  @@index([songAnnotationId])
}

model RecordPlayerTrack {
  id       String  @id @default(cuid())
  songId   String
  song     Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  position Int
  active   Boolean @default(true)

  @@unique([position])
  @@index([songId])
}

model BoardPost {
  id                  String    @id @default(cuid())
  artistId            String
  artist              Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title               String
  headline            String
  body                String    @default("")
  imageUrl            String?
  posX                Float?
  posY                Float?
  rotation            Float?
  positionPinnedUntil DateTime?
  pinColor            String?
  publishedAt         DateTime?
  archivedAt          DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([artistId])
  @@index([publishedAt])
}

model CompanyProfile {
  id        String   @id @default("main")
  title     String   @default("")
  bio       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyMember {
  id            String   @id @default(cuid())
  name          String
  role          String   @default("")
  bio           String   @default("")
  imageUrl      String   @default("")
  imagePathname String?
  isVisible     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isVisible, sortOrder])
}

model FashionTalent {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  role             FashionTalentRole
  bio              String               @default("")
  isVisible        Boolean              @default(true)
  order            Int                  @default(0)
  instagramProfile String?
  tiktokProfile    String?
  twitterProfile   String?
  youtubeProfile   String?
  facebookProfile  String?
  email            String?
  website          String?
  agencyName       String?
  agencyContact    String?
  images           FashionTalentImage[]
  lookCredits      FashionLookCredit[]
  pieceCredits     FashionPieceCredit[]
  collectionCredits FashionCollectionCredit[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([isVisible, order])
}

model FashionTalentImage {
  id        String        @id @default(cuid())
  talentId  String
  talent    FashionTalent @relation(fields: [talentId], references: [id], onDelete: Cascade)
  url       String
  pathname  String?
  usage     String        @default("portrait")
  altText   String        @default("")
  sortOrder Int           @default(0)
  isPrimary Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([talentId, sortOrder])
}

model FashionCollection {
  id            String                    @id @default(cuid())
  title         String
  slug          String                    @unique
  description   String                    @default("")
  about         String                    @default("")
  season        String                    @default("")
  location      String                    @default("")
  coverImage    String                    @default("")
  coverPathname String?
  isVisible     Boolean                   @default(true)
  order         Int                       @default(0)
  looks         FashionLook[]
  credits       FashionCollectionCredit[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([isVisible, order])
}

model FashionCollectionCredit {
  id           String            @id @default(cuid())
  collectionId String
  collection   FashionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  talentId     String?
  talent       FashionTalent?    @relation(fields: [talentId], references: [id], onDelete: Cascade)
  crewId       String?
  crew         FashionCrew?      @relation("CollectionCreditCrew", fields: [crewId], references: [id], onDelete: SetNull)
  creditName   String            @default("")
  roleLabel    String            @default("")
  sortOrder    Int               @default(0)

  @@index([collectionId, sortOrder])
  @@index([talentId])
  @@index([crewId])
}

model FashionLook {
  id           String              @id @default(cuid())
  title        String
  slug         String              @unique
  description  String              @default("")
  isVisible    Boolean             @default(true)
  order        Int                 @default(0)
  collectionId String?
  collection   FashionCollection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images       FashionLookImage[]
  pieces       FashionPiece[]
  credits      FashionLookCredit[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([isVisible, order])
  @@index([collectionId])
}

model FashionLookImage {
  id        String      @id @default(cuid())
  lookId    String
  look      FashionLook @relation(fields: [lookId], references: [id], onDelete: Cascade)
  url       String
  pathname  String?
  usage     String      @default("lookbook")
  altText   String      @default("")
  sortOrder Int         @default(0)
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([lookId, sortOrder])
}

model FashionPiece {
  id        String               @id @default(cuid())
  lookId    String
  look      FashionLook          @relation(fields: [lookId], references: [id], onDelete: Cascade)
  name      String
  buyUrl    String?
  imageUrl  String               @default("")
  pathname  String?
  sortOrder Int                  @default(0)
  credits   FashionPieceCredit[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([lookId, sortOrder])
}

model FashionLookCredit {
  id         String         @id @default(cuid())
  lookId     String
  look       FashionLook    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  talentId   String?
  talent     FashionTalent? @relation(fields: [talentId], references: [id], onDelete: Cascade)
  crewId     String?
  crew       FashionCrew?   @relation("LookCreditCrew", fields: [crewId], references: [id], onDelete: SetNull)
  creditName String         @default("")
  roleLabel  String         @default("")
  sortOrder  Int            @default(0)

  @@index([lookId, sortOrder])
  @@index([lookId, talentId])
  @@index([talentId])
  @@index([crewId])
}

model FashionPieceCredit {
  id         String         @id @default(cuid())
  pieceId    String
  piece      FashionPiece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  talentId   String?
  talent     FashionTalent? @relation(fields: [talentId], references: [id], onDelete: Cascade)
  crewId     String?
  crew       FashionCrew?   @relation("PieceCreditCrew", fields: [crewId], references: [id], onDelete: SetNull)
  creditName String         @default("")
  roleLabel  String         @default("")
  sortOrder  Int            @default(0)

  @@index([pieceId, sortOrder])
  @@index([pieceId, talentId])
  @@index([talentId])
  @@index([crewId])
}

model FashionCrew {
  id           String               @id @default(cuid())
  name         String
  role         String               @default("")
  externalUrl  String               @default("")
  imageUrl     String               @default("")
  pathname     String?
  lookCredits  FashionLookCredit[]  @relation("LookCreditCrew")
  pieceCredits FashionPieceCredit[] @relation("PieceCreditCrew")
  collectionCredits FashionCollectionCredit[] @relation("CollectionCreditCrew")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

enum FashionTalentRole {
  MODEL
  DESIGNER
  PHOTOGRAPHER
  EDITOR
  STYLIST
  OTHER
}
