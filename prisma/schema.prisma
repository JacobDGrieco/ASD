generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Artist {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  bio               String   @default("")
  aboutMe           String   @default("")
  portrait          String   @default("")
  order             Int      @default(0)
  soundcloudProfile String?
  spotifyProfile    String?
  appleMusicProfile String?
  youtubeProfile    String?
  instagramProfile  String?
  twitterProfile    String?
  facebookProfile   String?
  tiktokProfile     String?
  snapchatProfile   String?
  youtubeSocialProfile String?
  images            ArtistImage[]
  albums            Album[]
  adminAccess       ArtistAdminAccess?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ArtistAdminAccess {
  id           String   @id @default(cuid())
  artistId      String   @unique
  artist        Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Album {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  type          AlbumType
  coverArt      String       @default("")
  otherArtistName String?
  aboutText     String       @default("")
  soundcloudUrl String?
  spotifyUrl    String?
  appleMusicUrl String?
  youtubeUrl    String?
  releaseDate   DateTime
  artistId      String
  artist        Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  images        AlbumImage[]
  songPlacements SongAlbum[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([artistId])
}

model ArtistImage {
  id        String   @id @default(cuid())
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  url        String
  pathname   String?
  usage      String   @default("portrait")
  altText    String   @default("")
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([artistId, sortOrder])
}

model AlbumImage {
  id        String   @id @default(cuid())
  albumId    String
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url        String
  pathname   String?
  usage      String   @default("cover")
  altText    String   @default("")
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([albumId, sortOrder])
}

enum AlbumType {
  ALBUM
  SINGLE
  EP
}

model Song {
  id            String              @id @default(cuid())
  title         String
  slug          String              @unique
  duration      String              @default("")
  artwork       String              @default("")
  soundcloudUrl String?
  spotifyUrl    String?
  appleMusicUrl String?
  youtubeUrl    String?
  placements    SongAlbum[]
  images        SongImage[]
  meta          SongMeta?
  lyricBlocks   LyricBlock[]
  recordSlots   RecordPlayerTrack[]
}

model SongAlbum {
  id             String   @id @default(cuid())
  songId         String
  albumId        String
  trackNumber    Int
  discNumber     Int      @default(1)
  placementOrder Int
  song           Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  album          Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([songId, albumId])
  @@index([songId, placementOrder])
  @@index([albumId, discNumber, trackNumber])
}

model SongImage {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  url       String
  pathname  String?
  usage     String   @default("artwork")
  altText   String   @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([songId, sortOrder])
}

model SongMeta {
  id          String    @id @default(cuid())
  songId      String    @unique
  song        Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  aboutText   String    @default("")
  producers   String    @default("")
  writers     String    @default("")
  featuredArtists String @default("")
  tags        String[]  @default([])
  releaseDate DateTime?
}

model LyricBlock {
  id          String       @id @default(cuid())
  songId      String
  song        Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  text        String
  blockOrder  Int
  annotations Annotation[]

  @@index([songId])
}

model Annotation {
  id           String     @id @default(cuid())
  lyricBlockId String
  lyricBlock   LyricBlock @relation(fields: [lyricBlockId], references: [id], onDelete: Cascade)
  startChar    Int
  endChar      Int
  explanation  String

  @@index([lyricBlockId])
}

model RecordPlayerTrack {
  id       String  @id @default(cuid())
  songId   String
  song     Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  position Int
  active   Boolean @default(true)

  @@unique([position])
  @@index([songId])
}
