{
	"buildCommand": "npm run build",
	"ignoreCommand": "sh -c 'echo \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -q \"\\[deploy\\]\" && exit 1 || exit 0'",
	"outputDirectory": "dist",
	"framework": "vite",
	"rewrites": [
		{
			"source": "/api/artists",
			"destination": "/api/public?resource=artists"
		},
		{
			"source": "/api/artists/:slug",
			"destination": "/api/public?resource=artist&slug=:slug"
		},
		{
			"source": "/api/songs/:slug",
			"destination": "/api/public?resource=song&slug=:slug"
		},
		{
			"source": "/api/albums/:slug",
			"destination": "/api/public?resource=album&slug=:slug"
		},
		{
			"source": "/api/record-player",
			"destination": "/api/public?resource=recordPlayer"
		},
		{
			"source": "/api/videos",
			"destination": "/api/public?resource=videos"
		},
		{
			"source": "/admin",
			"destination": "/index.html"
		},
		{
			"source": "/admin/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/artists/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/videos",
			"destination": "/index.html"
		},
		{
			"source": "/songs/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/@vite/:path*",
			"destination": "/@vite/:path*"
		},
		{
			"source": "/:artistSlug([^@.][^./]*)/:albumSlug([^@.][^./]*)/:songSlug([^@.][^./]*)",
			"destination": "/index.html"
		},
		{
			"source": "/:artistSlug([^@.][^./]*)/:albumSlug([^@.][^./]*)",
			"destination": "/index.html"
		}
	]
}
