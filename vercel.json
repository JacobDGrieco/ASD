{
	"buildCommand": "npm run build",
	"ignoreCommand": "sh -c 'echo \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -q \"\\[deploy\\]\" && exit 1 || exit 0'",
	"outputDirectory": "dist",
	"framework": "vite",
	"rewrites": [
		{
			"source": "/api/artists",
			"destination": "/api/public?resource=artists"
		},
		{
			"source": "/api/artists/:slug",
			"destination": "/api/public?resource=artist&slug=:slug"
		},
		{
			"source": "/api/songs/:id",
			"destination": "/api/public?resource=song&id=:id"
		},
		{
			"source": "/api/albums/:id",
			"destination": "/api/public?resource=album&id=:id"
		},
		{
			"source": "/api/record-player",
			"destination": "/api/public?resource=recordPlayer"
		},
		{
			"source": "/api/crosshair",
			"destination": "/api/public?resource=crosshair"
		},
		{
			"source": "/api/fashion/talent",
			"destination": "/api/public?resource=fashionTalentList"
		},
		{
			"source": "/api/fashion/talent/:slug",
			"destination": "/api/public?resource=fashionTalent&slug=:slug"
		},
		{
			"source": "/api/fashion/looks",
			"destination": "/api/public?resource=fashionLooksList"
		},
		{
			"source": "/api/fashion/looks/:slug",
			"destination": "/api/public?resource=fashionLook&slug=:slug"
		},
		{
			"source": "/api/fashion/catalogue",
			"destination": "/api/public?resource=fashionCatalogue"
		},
		{
			"source": "/api/fashion/collections/:slug",
			"destination": "/api/public?resource=fashionCollection&slug=:slug"
		},
		{
			"source": "/api/admin/board",
			"destination": "/api/admin/artists?resource=board"
		},
		{
			"source": "/api/admin/fashion/talent",
			"destination": "/api/admin/fashion?resource=talent"
		},
		{
			"source": "/api/admin/fashion/looks",
			"destination": "/api/admin/fashion?resource=looks"
		},
		{
			"source": "/api/admin/fashion/collections",
			"destination": "/api/admin/fashionCollections"
		},
		{
			"source": "/api/admin/fashion/collections/:id",
			"destination": "/api/admin/fashionCollections?id=:id"
		},
		{
			"source": "/admin",
			"destination": "/index.html"
		},
		{
			"source": "/admin/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/artists/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/crosshair",
			"destination": "/index.html"
		},
		{
			"source": "/shelf",
			"destination": "/index.html"
		},
		{
			"source": "/board",
			"destination": "/index.html"
		},
		{
			"source": "/songs/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/albums/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/music",
			"destination": "/index.html"
		},
		{
			"source": "/music/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/fashion",
			"destination": "/index.html"
		},
		{
			"source": "/fashion/:path*",
			"destination": "/index.html"
		},
		{
			"source": "/@vite/:path*",
			"destination": "/@vite/:path*"
		}
	]
}
